BOT_TOKEN=
ADMIN_IDS=
ADMIN_LOG_CHAT=
ACTION_MODE=restrict

# Risk Scoring - Gewichtungen
RISK_JOIN_EVENT=10
RISK_MULTI_JOIN_BONUS=20
RISK_ACCOUNT_AGE_THRESHOLD=7
RISK_ACCOUNT_AGE_BONUS=30
RISK_NO_USERNAME=15
RISK_NO_PROFILE_PHOTO=10

# Risk Scoring - Schwellenwerte
RISK_RESTRICT_THRESHOLD=60
RISK_BAN_THRESHOLD=120

# Risk Scoring - Decay
RISK_DECAY_AMOUNT=20
RISK_DECAY_HOURS=24
RISK_AUTO_UNRESTRICT_BUFFER=20

# Join Detection
JOIN_WINDOW_HOURS=24
JOIN_THRESHOLD=5

# ============================================================================
# Anti-Impersonation (09/2026)
# ============================================================================
# Die echten Accounts, die geschützt werden. Sie sind von allen Maßnahmen
# ausgenommen und dürfen ihr eigenes Foto/ihren eigenen Namen tragen.
PROTECTED_USER_IDS=382863507

# Profilfoto-Fingerabdrücke (big_file_unique_id aus getChat).
# Ein fremder Account mit demselben Wert trägt dasselbe Bild -> automatischer Ban.
# Erfassen bzw. nach Bildwechsel aktualisieren mit:  npm run identity:reference
PROTECTED_PHOTO_IDS=

# Geschützte Namen. WICHTIG: keine häufigen Vornamen aufnehmen.
# "Marco" allein erzeugte in der Messung 64 Fehlalarme (23 echte Mitglieder
# heißen so) — deshalb nur der vollständige Anzeigename und die Marke.
PROTECTED_NAMES=Marco McLac2000,McLac2000,Geldhelden,Geldhelden Team,Geldhelden Support

# Ähnlichkeitsschwelle für den Namensvergleich (0-100)
IMPERSONATION_SIMILARITY_THRESHOLD=80

# Automatische Sperre bei ZWEIFELSFREIER Täuschung
# (identisches Profilfoto ODER Namenstreffer + Homoglyphen/unsichtbare Zeichen).
# Reine Namensähnlichkeit löst NIE eine Sperre aus, nur einen Alarm.
IMPERSONATION_AUTO_BAN=false

# ============================================================================
# Werbe-Wellen über den Ziel-Link (09/2026)
# ============================================================================
# Ein fremder Telegram-Link, den mehrere Konten in mehreren Gruppen posten,
# ist der gemeinsame Nenner einer Strohmann-Kampagne. Erfassung ist harmlos
# und daher an; die Durchsetzung ist aus, bis die Trefferquote gemessen wurde.
CAMPAIGN_LINKS_ENABLED=true
CAMPAIGN_WINDOW_HOURS=72
CAMPAIGN_MIN_USERS=3
CAMPAIGN_MIN_CHATS=2
CAMPAIGN_MIN_SIGHTINGS=5

# Löscht alle Nachrichten mit dem Link und sperrt ihn für die Zukunft.
# Erst einschalten, nachdem /links ein paar Tage plausible Ergebnisse zeigt.
CAMPAIGN_LINKS_AUTO_BLOCK=false

# Sperrt zusätzlich, wer den Link SELBST (nicht weitergeleitet) in mindestens
# zwei Gruppen gepostet hat. Wer weiterleitet, warnt meist — der wird nie
# gesperrt. Trotzdem der schärfste Schalter: zuletzt einschalten.
CAMPAIGN_AUTO_BAN_SPREADERS=false

# Eigene Kanäle und Partner, die Mitglieder legitim überall teilen.
# Die 62 verwalteten Gruppen werden automatisch erfasst (auch private, über
# ihren Einladungslink) — hier nur, was darüber hinausgeht.
OWN_LINK_EXTRAS=geldhelden,mclac2000,staatenlos

# Zeitzone
TZ=Asia/Manila

# ============================================================================
# Profilprüfung beim Beitritt (09/2026)
# ============================================================================
# Wer in seiner Bio auf eine FREMDE Telegram-Gruppe verweist, wirbt ab.
# Links auf unsere eigenen Gruppen (link_allowlist) sind immer ausgenommen.
PROFILE_CHECK_ENABLED=true

# Sperrt automatisch. Erst einschalten, nachdem die Messung am Bestand
# (scripts/measure-profile-risk.ts) eine tragbare Trefferzahl gezeigt hat.
PROFILE_AUTO_BAN=false

# true = ein fremder Gruppenlink in der Bio genügt.
# false = der Link muss von einem zweiten Merkmal begleitet sein
#         (Verschleierung, Anwerbe-Sprache, Wegwerf-Benutzername, Bild-Dublette).
# Ein VERSCHLEIERTER Link ("t․me/+abc", "t dot me/+abc") sperrt in beiden Fällen —
# dafür gibt es keinen harmlosen Grund.
PROFILE_STRICT_MODE=false

# ============================================================================
# Erstnachrichten-Prüfung (09/2026)
# ============================================================================
# Was ein Konto in seinen ersten Nachrichten schreibt, ist das
# aussagekräftigste Signal, das es gibt. Bewertet werden die ersten 5
# Nachrichten je Gruppe nach einem PUNKTESYSTEM — keine Einzelregel darf
# allein sperren, sonst trifft es den Botschafter mit einem englischen Satz.
#
# Signalgruppen: Verkauf (Zahlungskonten, Dokumente), Werbesprache, Form
# (Emoji-Wall, fremdsprachiger Text), Konto (verfremdeter Name, Zeitpunkt).
# Für eine Sperre braucht es 70 Punkte UND zwei verschiedene INHALTLICHE
# Gruppen — „Konto" zählt dabei nicht mit.
FIRST_MESSAGE_CHECK_ENABLED=true

# Sperrt automatisch und löscht die Nachricht.
# Erst einschalten, wenn /erstnachricht über mehrere Tage plausible Zahlen
# zeigt. Vorher gab es im ganzen System keinen gespeicherten Nachrichtentext,
# also auch keine Möglichkeit, rückwirkend zu messen.
FIRST_MESSAGE_AUTO_BAN=false

# Zeitpunkt des Scharfschaltens (ISO). In den ersten 48 Stunden danach wird
# jede Sperre im Admin-Chat als "STICHPROBE" gekennzeichnet — in dieser Zeit
# ist jede einzelne eine Kontrolle der Regel.
FIRST_MESSAGE_ARMED_AT=
